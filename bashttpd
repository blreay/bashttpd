# Reworked by:     Josh Cartwright, 2012

warn() { echo "WARNING: $@" >&2; }

urldecode() {
   printf '%b' "$(echo "$1" | sed 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
}

[ -r bashttpd.conf ] || {
   cat >bashttpd.conf <<'EOF'
#
# bashttpd.conf - configuration for bashttpd
#
# The behavior of bashttpd is dictated by the evaluation
# of rules specified in this configuration file.  Each rule
# is evaluated until one is matched.  If no rule is matched,
# bashttpd will serve a 500 Internal Server Error.
#
# The format of the rules are:
#    on_uri_match REGEX command [args]
#    unconditionally command [args]
#
# on_uri_match:
#   On an incoming request, the URI is checked against the specified
#   (bash-supported extended) regular expression, and if encounters a match the
#   specified command is executed with the specified arguments.
#
#   For additional flexibility, on_uri_match will also pass the results of the
#   regular expression match, ${BASH_REMATCH[@]} as additional arguments to the
#   command.
#
# unconditionally:
#   Always serve via the specified command.  Useful for catchall rules.
#
# The following commands are available for use:
#
#   serve_file FILE
#     Statically serves a single file.
#
#   serve_dir_with_tree DIRECTORY
#     Statically serves the specified directory using 'tree'.  It must be
#     installed and in the PATH.
#
#   serve_dir_with_ls DIRECTORY
#     Statically serves the specified directory using 'ls -al'.
#
#   serve_dir  DIRECTORY
#     Statically serves a single directory listing.  Will use 'tree' if it is
#     installed and in the PATH, otherwise, 'ls -al'
#
#   serve_dir_or_file_from DIRECTORY
#     Serves either a directory listing (using serve_dir) or a file (using
#     serve_file).  Constructs local path by appending the specified root
#     directory, and the URI portion of the client request.
#
#   serve_static_string STRING
#     Serves the specified static string with Content-Type text/plain.
#
# Examples of rules:
#
# on_uri_match '^/issue$' serve_file "/etc/issue"
#
#   When a client's requested URI matches the string '/issue', serve them the
#   contents of /etc/issue
#
# on_uri_match 'root' serve_dir /
#
#   When a client's requested URI has the word 'root' in it, serve up
#   a directory listing of /
#
# DOCROOT=/var/www/html
# on_uri_match '/(.*)' serve_dir_or_file_from "$DOCROOT"
#   When any URI request is made, attempt to serve a directory listing
#   or file content based on the request URI, by mapping URI's to local
#   paths relative to the specified "$DOCROOT"
#


unconditionally serve_static_string 'Hello, world!  You can configure bashttpd by modifying bashttpd.conf.'

# More about commands:
#
# It is possible to somewhat easily write your own commands.  An example
# may help.  The following example will serve "Hello, $x!" whenever
# a client sends a request with the URI /say_hello_to/$x:
#
# serve_hello() {
#    add_response_header "Content-Type" "text/plain"
#    send_response_ok_exit <<< "Hello, $2!"
# }
# on_uri_match '^/say_hello_to/(.*)$' serve_hello
#
# Like mentioned before, the contents of ${BASH_REMATCH[@]} are passed
# to your command, so its possible to use regular expression groups
# to pull out info.
#
# With this example, when the requested URI is /say_hello_to/Josh, serve_hello
# is invoked with the arguments '/say_hello_to/Josh' 'Josh',
# (${BASH_REMATCH[0]} is always the full match)
EOF
   warn "Created bashttpd.conf using defaults.  Please review it/configure before running bashttpd again."
   exit 1
}

recv() { echo "< $@" >&2; }
send() { echo "> $@" >&2;
         printf '%s\r\n' "$*"; }

[[ $UID = 0 ]] && warn "It is not recommended to run bashttpd as root."

DATE=$(date +"%a, %d %b %Y %H:%M:%S %Z")
declare -a RESPONSE_HEADERS=(
      "Date: $DATE"
   "Expires: $DATE"
    "Server: Slash Bin Slash Bash"
)

add_response_header() {
   RESPONSE_HEADERS+=("$1: $2")
}

declare -a HTTP_RESPONSE=(
   [200]="OK"
   [400]="Bad Request"
   [403]="Forbidden"
   [404]="Not Found"
   [405]="Method Not Allowed"
   [500]="Internal Server Error"
)

send_response() {
   local code=$1
   send "HTTP/1.0 $1 ${HTTP_RESPONSE[$1]}"
   for i in "${RESPONSE_HEADERS[@]}"; do
      send "$i"
   done
   send
   #sleep 99999
   while read -r line; do
      send "$line"
   done
}
send_response_bin() {
   local code=$1
   local filename=$2
   send "HTTP/1.0 $1 ${HTTP_RESPONSE[$1]}"
   for i in "${RESPONSE_HEADERS[@]}"; do
      send "$i"
   done
   send
   #sleep 99999
   cat "$filename"
   #wait HTTP client to read all data, avoid error "curl: (18) transfer closed with 7680 bytes remaining to read"
   # equal to "KEEP-ALIVE"
   sleep 10
}

send_response_ok_exit() { send_response 200; exit 0; }
send_response_ok_exit_bin() { send_response_bin 200 "$1"; exit 0; }

fail_with() {
   send_response "$1" <<< "$1 ${HTTP_RESPONSE[$1]}"
   exit 1
}

serve_file() {
   local file=$1

   CONTENT_TYPE=
   case "$file" in
     *\.css)
       CONTENT_TYPE="text/css"
       ;;
     *\.js)
       CONTENT_TYPE="text/javascript"
       ;;
     *\.md|*\.log|*\.txt)
       CONTENT_TYPE="text/markdown; charset=utf-8"
       ;;
     *)
       read -r CONTENT_TYPE   < <(file -b --mime-type "$file")
       ;;
   esac

   add_response_header "Content-Type"   "$CONTENT_TYPE";

   read -r CONTENT_LENGTH < <(stat -c'%s' "$file")         && \
      add_response_header "Content-Length" "$CONTENT_LENGTH"

	if [[ CONTENT_TYPE =~ text* ]]; then
   		send_response_ok_exit < "$file"
	else
   		send_response_ok_exit_bin "$file"
	fi
}

serve_dir_with_tree()
{
   local dir="$1" tree_vers tree_opts basehref x

   add_response_header "Content-Type" "text/html; charset=utf-8"

   # The --du option was added in 1.6.0.
   read x tree_vers x < <(tree --version)
   [[ $tree_vers == v1.6* ]] && tree_opts="--du"

	## fix one bug to list root dir of DOCROOT
   ## The awk stage injects the breadcrumb / [ .. ] / button lines and
   ## rewrites the tree entry lines as an HTML table with one <td> per
   ## independent column (permissions, user, group, size, date, name),
   ## each left-aligned.  The tree-drawing prefix is kept inside the
   ## name cell.
   send_response_ok_exit < \
      <({ tree -H "${2%/}" --charset=utf-8 -apsthugDF --dirsfirst  -L 1 $tree_opts -D "$dir"; } | \
         BAS_CRUMBS="$(dir_crumbs "$2")" BAS_CONTROLS="$(dir_controls)" awk '
            {
               line = $0
               if (line ~ /<h1>Directory Tree<\/h1>/) {
                  print line
                  print "\t" ENVIRON["BAS_CRUMBS"] "<br>"
                  print "\t<a href=\"../\">[&nbsp;..&nbsp;]</a>"
                  print ENVIRON["BAS_CONTROLS"]
                  next
               }
               if (line ~ /\]&nbsp;&nbsp;&nbsp;&nbsp;<a/) {
                  p = index(line, "[")
                  q = index(substr(line, p), "]")
                  inner = substr(line, p + 1, q - 2)
                  gsub(/(&nbsp;)+/, "\\&nbsp;", inner)
                  nf = split(inner, f, /&nbsp;/)
                  if (nf < 7) {
                     if (intbl) { print "</table>"; intbl = 0 }
                     print line
                     next
                  }
                  if (!intbl) {
                     print "</p>"
                     print "<table cellspacing=\"4\" cellpadding=\"0\">"
                     print "<tr>" td("permissions") td("user") td("group") td("size") td("date") td("name") "</tr>"
                     intbl = 1
                  }
                  pre = substr(line, 1, p - 1)
                  tail = substr(line, p + q - 1)
                  sub(/^\]/, "", tail)
                  sub(/^(&nbsp;)+/, "", tail)
                  sub(/<br>$/, "", tail)
                  print "<tr>" td(f[1]) td(f[2]) td(f[3]) td(f[4]) td(f[5] " " f[6] " " f[7]) td(pre " " tail) "</tr>"
                  next
               }
               if (intbl) { print "</table>"; intbl = 0 }
               print line
            }
            END { if (intbl) print "</table>" }
            function td(x) { return "<td style=\"text-align:left;white-space:nowrap;padding-right:16px\">" x "</td>" }
         ')
}

serve_dir_with_ls()
{
   local dir=$1

   add_response_header "Content-Type" "text/plain"

   send_response_ok_exit < \
      <(ls -la "$dir")
}

serve_dir() {
   local dir=$1

   # If `tree` is installed, use that for pretty output.
   which tree &>/dev/null && \
      serve_dir_with_tree "$@"

   serve_dir_with_ls "$@"

   fail_with 500
}

serve_dir_or_file_from() {
   local URL_PATH=$1/$3
   shift

   # trim the parameter in url from GET request, used for markdown viewer by zzy at 2026/05/07
   URL_PATH=${URL_PATH%\?*}
   # decode percent-encoded characters (e.g. %E4%B8%AD -> 中) to support Chinese/Unicode filenames
   URL_PATH=$(urldecode "$URL_PATH")
   # block path traversal (also catches encoded ..  via %2e%2e since we decode first)
   [[ $URL_PATH == *..* ]] && fail_with 400

   # Serve index file if exists in requested directory
   [[ -d $URL_PATH && -f $URL_PATH/index.html && -r $URL_PATH/index.html ]] && \
      URL_PATH="$URL_PATH/index.html"

   if [[ -f $URL_PATH ]]; then
      [[ -r $URL_PATH ]] && \
         serve_file "$URL_PATH" "$@" || fail_with 403
   elif [[ -d $URL_PATH ]]; then
      [[ -x $URL_PATH ]] && \
         serve_dir  "$URL_PATH" "$@" || fail_with 403
   fi

   fail_with 404
}

serve_static_string() {
   add_response_header "Content-Type" "text/plain"
   send_response_ok_exit <<< "$1"
}

# Send a small text response to a POST request and exit right away.  Unlike
# send_response(), it does not wait for the client to close the connection.
bas_post_reply() {
   local body="$3"
   [[ -n $body ]] || body="$1 ${HTTP_RESPONSE[$1]}: $2"
   add_response_header "Content-Length" "${#body}"
   add_response_header "Connection" "close"
   send "HTTP/1.0 $1 ${HTTP_RESPONSE[$1]}"
   local h
   for h in "${RESPONSE_HEADERS[@]}"; do
      send "$h"
   done
   send
   printf '%s' "$body"
   exit 0
}

# Resolve a URI to the local directory it maps to, by replaying the routing
# rules of bashttpd.conf (the same mapping as file serving).  Prints the
# local path; exits non-zero if no rule matches or the matched rule is not
# directory-based.
resolve_local_dir() {
   local uri="$1" cmd
   (
      on_uri_match() {
         local regex="$1"
         shift
         [[ $uri =~ $regex ]] || return 0
         cmd="$1"
         case "$cmd" in
            serve_dir|serve_dir_with_tree|serve_dir_with_ls)
               printf '%s' "$2" ;;
            serve_dir_or_file_from)
               printf '%s/%s' "$2" "${BASH_REMATCH[1]}" ;;
            *)
               echo "resolve_local_dir: non-directory command: $cmd" >&2
               exit 1 ;;
         esac
         exit 0
      }
      unconditionally() {
         echo "resolve_local_dir: URI fell through to unconditional rule" >&2
         exit 1
      }
      source "${BASH_SOURCE[0]%/*}/bashttpd.conf"
      echo "resolve_local_dir: no rule matched URI: $uri" >&2
      exit 1
   )
}

# Create a subdirectory of the directory the requested URI maps to.
# Used by the "CreateDir" button on directory listings; the new name
# arrives percent-encoded in the X-Bas-Name header.
bas_do_mkdir() {
   local dir name target
   name=$(urldecode "$X_BAS_NAME")
   if [[ -z $name || $name == */* || $name == . || $name == .. ]]; then
      bas_post_reply 400 "bad directory name: $name"
   fi
   dir=$(resolve_local_dir "$REQUEST_URI") || \
      bas_post_reply 500 "no directory rule for: $REQUEST_URI"
   target="${dir%/}/$name"
   if [[ -e $target ]]; then
      bas_post_reply 403 "already exists: $name"
   fi
   if mkdir -p "$target"; then
      bas_post_reply 200 "created: $name"
   fi
   bas_post_reply 500 "mkdir failed: $target"
}

# Write the POST body as a new file in the directory the requested URI maps
# to.  Used by the "Upload" button on directory listings; the file name
# arrives percent-encoded in the X-Bas-Name header.
bas_do_upload() {
   local dir name target
   name=$(urldecode "$X_BAS_NAME")
   if [[ -z $name || $name == */* || $name == . || $name == .. ]]; then
      bas_post_reply 400 "bad file name: $name"
   fi
   dir=$(resolve_local_dir "$REQUEST_URI") || \
      bas_post_reply 500 "no directory rule for: $REQUEST_URI"
   target="${dir%/}/$name"
   if [[ -n $BODY_FILE ]] && cat "$BODY_FILE" > "$target"; then
      bas_post_reply 200 "uploaded: $name"
   fi
   bas_post_reply 500 "upload failed: $target"
}

# Favorite paths are stored in favorite.json (a JSON array of URI strings)
# in the server's working directory.
FAVORITES_FILE="${FAVORITES_FILE:-favorite.json}"

# Print favorite URIs, one per line.
fav_load() {
   local content line
   [[ -r $FAVORITES_FILE ]] || return 0
   content=$(<"$FAVORITES_FILE")
   while read -r line; do
      line=${line//[\"\[\],]/}
      line=$(echo "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
      [[ -n $line ]] && echo "$line"
   done <<< "$content"
}

# Write favorites (URIs on stdin, one per line) to favorite.json.
fav_save() {
   local uri out="[" sep=""
   while read -r uri; do
      [[ -z $uri ]] && continue
      out="$out$sep
  \"$uri\""
      sep=","
   done
   [[ -n $sep ]] && out="$out
"
   printf '%s]\n' "$out" > "$FAVORITES_FILE"
}

# Return the favorite list as a JSON array.  Used by the Favorite menu.
bas_do_favlist() {
   local uri out="[" sep=""
   while read -r uri; do
      [[ -z $uri ]] && continue
      out="$out$sep
  \"$uri\""
      sep=","
   done < <(fav_load)
   [[ -n $sep ]] && out="$out
"
   out="$out]"
   add_response_header "Content-Type" "application/json"
   bas_post_reply 200 "favorites" "$out"
}

# Add the requested URI to favorite.json (deduplicated).  Used by the
# "Add Current Path to favorite" menu item.
bas_do_favadd() {
   local uri="${REQUEST_URI%%\?*}" fav dup=0
   uri="${uri%/}"
   [[ -z $uri ]] && uri="/"
   local -a list=()
   while read -r fav; do
      [[ -z $fav ]] && continue
      if [[ $fav == "$uri" ]]; then dup=1; else list+=("$fav"); fi
   done < <(fav_load)
   if [[ $dup -eq 1 ]]; then
      bas_post_reply 200 "already in favorites: $uri"
   fi
   list+=("$uri")
   printf '%s\n' "${list[@]}" | fav_save
   bas_post_reply 200 "added: $uri"
}

# Build a clickable breadcrumb of the current URI path: every '/'-separated
# segment links to its prefix directory, e.g. for /myhome/work/cubenet
# clicking "work" goes to /myhome/work.
dir_crumbs() {
   local uri="${1%%\?*}" seg cur="" out='<a href="/">/</a>'
   local -a parts
   uri="${uri%/}"
   IFS='/' read -ra parts <<< "$uri"
   for seg in "${parts[@]}"; do
      [[ -z $seg ]] && continue
      cur="$cur/$seg"
      out="$out/<a href=\"$cur/\">$(urldecode "$seg")</a>"
   done
   printf '%s' "$out"
}

# HTML controls (CreateDir / Upload buttons) injected into tree-based
# directory listings.  The buttons POST to the page's own URI with
# X-Bas-Action/X-Bas-Name headers, so they act on the directory that URI
# maps to.
# Multiple selected files are uploaded one request at a time.
dir_controls() {
   cat <<'BASHTML'
<span style="display:inline-block;width:96px;"></span>
<button style="font-family:sans-serif;" onclick="basMkdir()">CreateDir</button>
<button style="font-family:sans-serif;" onclick="document.getElementById('basFileInput').click()">Upload</button>
<button style="font-family:sans-serif;" onclick="basToggleFavMenu(event)">Favorite</button>
<input id="basFileInput" type="file" multiple style="display:none">
<span id="basStatus" style="font-family:monospace;"></span>
<br>
<script>
(function () {
   var base = location.pathname;
   if (base.charAt(base.length - 1) !== '/') base += '/';
   var status = document.getElementById('basStatus');
   var inp = document.getElementById('basFileInput');
   window.basMkdir = function () {
      var name = prompt('New directory name:');
      if (!name) return;
      if (/[\/\x00]/.test(name) || name === '.' || name === '..') {
         status.textContent = 'invalid directory name';
         return;
      }
      status.textContent = 'mkdir ' + name + ' ...';
      fetch(base, {
         method: 'POST',
         headers: { 'X-Bas-Action': 'mkdir', 'X-Bas-Name': encodeURIComponent(name) }
      })
         .then(function (r) {
            return r.text().then(function (t) {
               status.textContent = r.status + ' ' + t;
               if (r.ok) setTimeout(function () { location.reload(); }, 800);
            });
         })
         .catch(function (e) { status.textContent = 'error: ' + e; });
   };
   inp.onchange = function () {
      var files = Array.prototype.slice.call(inp.files || []);
      if (!files.length) return;
      var pending = files.length;
      files.forEach(function (f, i) {
         setTimeout(function () {
            status.textContent = 'upload ' + (i + 1) + '/' + files.length + ': ' + f.name;
            fetch(base, {
               method: 'POST',
               headers: {
                  'X-Bas-Action': 'upload',
                  'X-Bas-Name': encodeURIComponent(f.name),
                  'Content-Type': 'application/octet-stream'
               },
               body: f
            }).then(function (r) {
               return r.text().then(function (t) {
                  status.textContent = r.status + ' ' + t;
                  if (--pending === 0) {
                     inp.value = '';
                     setTimeout(function () { location.reload(); }, 800);
                  }
               });
            }).catch(function (e) {
               status.textContent = 'error: ' + e;
               if (--pending === 0) inp.value = '';
            });
         }, i * 100);
      });
   };

   // Favorite menu: section 1 lists saved paths, section 2 (below the
   // separator) adds the current path.
   var favMenu = null;
   function basCloseFavMenu() {
      if (favMenu) { favMenu.parentNode.removeChild(favMenu); favMenu = null; }
   }
   document.addEventListener('click', function () { basCloseFavMenu(); });
   window.basToggleFavMenu = function (e) {
      e.stopPropagation();
      if (favMenu) { basCloseFavMenu(); return; }
      favMenu = document.createElement('div');
      favMenu.style.cssText = 'position:absolute;z-index:100;background:#fff;border:1px solid #888;box-shadow:2px 2px 5px rgba(0,0,0,0.3);min-width:280px;font-family:sans-serif;font-size:13px;';
      var r = e.target.getBoundingClientRect();
      favMenu.style.left = (r.left + window.scrollX) + 'px';
      favMenu.style.top = (r.bottom + window.scrollY) + 'px';
      document.body.appendChild(favMenu);
      basLoadFavMenu(favMenu);
   };
   function basFavItem(label, href) {
      return '<div style="padding:6px 10px;cursor:pointer;white-space:nowrap;" data-href="' + href + '">' + label + '</div>';
   }
   function basLoadFavMenu(m) {
      m.innerHTML = '<div style="padding:6px 10px;color:#888;">loading...</div>';
      fetch(base, { method: 'POST', headers: { 'X-Bas-Action': 'favlist' } })
         .then(function (r) { return r.json(); })
         .then(function (favs) {
            var html = '';
            if (!favs.length) {
               html += '<div style="padding:6px 10px;color:#999;">(no favorites)</div>';
            }
            favs.forEach(function (f) {
               html += basFavItem(decodeURIComponent(f), f);
            });
            html += '<div style="border-top:1px solid #bbb;margin:4px 0;"></div>';
            html += basFavItem('Add Current Path to favorite', '#add');
            m.innerHTML = html;
            Array.prototype.forEach.call(m.querySelectorAll('div[data-href]'), function (el) {
               el.onmouseover = function () { el.style.background = '#eee'; };
               el.onmouseout = function () { el.style.background = ''; };
               el.onclick = function () {
                  var p = el.getAttribute('data-href');
                  if (p === '#add') { basAddFav(function () { basLoadFavMenu(m); }); return; }
                  location.href = (p === '/' ? '/' : p + '/');
               };
            });
         })
         .catch(function (e) {
            m.innerHTML = '<div style="padding:6px 10px;color:#c00;">error: ' + e + '</div>';
         });
   }
   function basAddFav(cb) {
      status.textContent = 'adding current path to favorites ...';
      fetch(base, { method: 'POST', headers: { 'X-Bas-Action': 'favadd' } })
         .then(function (r) {
            return r.text().then(function (t) {
               status.textContent = r.status + ' ' + t;
               if (cb) cb();
            });
         })
         .catch(function (e) { status.textContent = 'error: ' + e; });
   }
})();
</script>
BASHTML
}


on_uri_match() {
   local regex=$1
   shift

	set -vx
	## used to test curl timeout
  [[ $REQUEST_URI =~ /timeout ]] && sleep $((60*60*24*3))

   [[ $REQUEST_URI =~ $regex ]] && \
      "$@" "${BASH_REMATCH[@]}"
}

unconditionally() {
   "$@" "$REQUEST_URI"
}

set -vx
# Request-Line HTTP RFC 2616 $5.1
read -r line || fail_with 400

# strip trailing CR if it exists
line=${line%%$'\r'}
recv "$line"

read -r REQUEST_METHOD REQUEST_URI REQUEST_HTTP_VERSION <<<"$line"

[ -n "$REQUEST_METHOD" ] && \
[ -n "$REQUEST_URI" ] && \
[ -n "$REQUEST_HTTP_VERSION" ] \
   || fail_with 400

# Only GET and POST are supported (POST is used by bas_mkdir / bas_upload)
{ [ "$REQUEST_METHOD" = "GET" ] || [ "$REQUEST_METHOD" = "POST" ]; } || fail_with 405

declare -a REQUEST_HEADERS

while read -r line; do
   line=${line%%$'\r'}
   recv "$line"

   # If we've reached the end of the headers, break.
   [ -z "$line" ] && break

   case "$line" in
      "Content-Length: "*) CONTENT_LENGTH="${line#Content-Length: }" ;;
      "X-Bas-Action: "*) X_BAS_ACTION="${line#X-Bas-Action: }" ;;
      "X-Bas-Name: "*) X_BAS_NAME="${line#X-Bas-Name: }" ;;
   esac
   REQUEST_HEADERS+=("$line")
done

# Read the POST body (up to Content-Length bytes) into a temp file so
# handlers can use it without blocking on connection EOF.
BODY_FILE=
if [ "$REQUEST_METHOD" = "POST" ] && [ -n "$CONTENT_LENGTH" ]; then
   BODY_FILE=$(mktemp "${TMPDIR:-/tmp}/bashttpd_body.XXXXXX")
   head -c "$CONTENT_LENGTH" > "$BODY_FILE"
fi

# The CreateDir / Upload buttons POST to the page's own URI with an
# X-Bas-Action header; they act on the directory that URI maps to, so
# handle them here, before the normal config dispatch.
if [ "$REQUEST_METHOD" = "POST" ] && [ -n "$X_BAS_ACTION" ]; then
   case "$X_BAS_ACTION" in
      mkdir)  bas_do_mkdir ;;
      upload) bas_do_upload ;;
      favlist) bas_do_favlist ;;
      favadd)  bas_do_favadd ;;
      *)      bas_post_reply 400 "unknown action: $X_BAS_ACTION" ;;
   esac
fi

source "${BASH_SOURCE[0]%/*}"/bashttpd.conf
fail_with 500
